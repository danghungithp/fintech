# InfluxDB 3 (Cloud Serverless) connection
# Copy to .env and fill in your token (never commit .env!)
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_HOST=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=fintech

# Public site URL for SEO (canonical link, Open Graph, sitemap.xml).
# Optional — defaults to https://fintech-52jk.vercel.app; set to your custom domain when available.
# SITE_URL=https://your-domain.com

# ------------------------------------------------------------- accounts
# Secret key signing login session cookies. REQUIRED on Vercel (generate:
# python -c "import secrets; print(secrets.token_hex(32))"). Sessions are
# dropped between requests when it changes, so keep it stable.
SECRET_KEY=

# Password for the /quan-tri admin page (review registrations, create users).
ADMIN_PASSWORD=

# Registration-request notifications sent to the admin mailbox.
# Option 1 (recommended): Gmail app password — enable 2FA, create an app
# password at https://myaccount.google.com/apppasswords then set:
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-char-app-password
# Option 2 (no credentials): FormSubmit relay is used automatically; the
# first request asks the NOTIFY_EMAIL owner to click a one-time activation link.
# NOTIFY_EMAIL=mcpsoftware@gmail.com
